# BÜLTEN READ — Security Phase 1
# Add real secrets in Netlify > Site configuration > Environment variables.
# NEVER commit actual secrets or put service-role keys in NEXT_PUBLIC_ vars.

# Account sign-in/sign-up (both mandatory to enable secured APIs)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...

# OpenAI (optional; AI remains safely disabled without this)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Supabase — list storage, analytics, unsubscribe and data export/erasure
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Sending — both required; Sender domain must be verified in Resend
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Project Factory <newsletter@YOUR-VERIFIED-DOMAIN>

# Random secret at least 32 characters; NEVER regenerate if emails have been sent,
# otherwise recipient unsubscribe links and encrypted tracking links stop working.
CAMPAIGN_SECURITY_SECRET=USE_A_RANDOM_64_CHARACTER_SECRET_FROM_A_PASSWORD_MANAGER

# Public canonical address for secure email action links
NEXT_PUBLIC_APP_URL=https://bultenoku.netlify.app
