# EDITOR ACCESS (default: free local editing without login)
# Leave absent or set to false now. Add true later to require login.
# NEXT_PUBLIC_REQUIRE_EDITOR_LOGIN=false
# When true, configure Supabase Auth keys below before the deploy.
# Even when false, all server-side publishing/upload/AI APIs remain locked.

# BÜLTEN READ — Free Supabase Auth (no custom domain needed)
# Add real values to Netlify > bultenoku > Project configuration > Environment variables.
# Public (browser-safe) Supabase credentials — both required for Auth.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Legacy projects may have an anon key (eyJ...); it can be used instead if necessary.
# NEVER publish server secrets. Not every public key starts with sb_publishable_.

# Server-only Supabase key — required for lists, analytics, account export/erasure
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Optional AI; independently disabled without the key.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Optional bulk sending; a verified sender domain/Resend setup is necessary.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Project Factory <newsletter@YOUR-VERIFIED-DOMAIN>

# Generate a random 64-character secret, store in Netlify only.
# Keep unchanged once email has been sent so old unsubscribe links continue working.
CAMPAIGN_SECURITY_SECRET=USE_A_RANDOM_64_CHARACTER_SECRET_FROM_A_PASSWORD_MANAGER
NEXT_PUBLIC_APP_URL=https://bultenoku.netlify.app

# Supabase dashboard > Authentication > URL Configuration:
# Site URL: https://bultenoku.netlify.app
# Redirect URLs: https://bultenoku.netlify.app/auth/callback
# Google OAuth: enable Google provider and create a Google Cloud OAuth client.
# Default Supabase Auth SMTP is NOT suitable for arbitrary public email signup.
