# BÜLTEN READ - server-only values must be set in Netlify environment, NEVER public JS.
NEXT_PUBLIC_APP_URL=https://your-deployment.example
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Use Supabase SQL Editor to apply migrations/20261105_security_data.sql first.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_SIDE_SERVICE_ROLE_KEY

# Optional AI functions: server-only.
OPENAI_API_KEY=YOUR_SERVER_SIDE_KEY
OPENAI_MODEL=gpt-4o-mini

# Mailing sender must be verified with Resend.
RESEND_API_KEY=YOUR_SERVER_SIDE_KEY
RESEND_FROM_EMAIL=Project Factory <newsletter@example.org>
TRACKING_SIGNING_SECRET=REPLACE_WITH_RANDOM_32_BYTES_OR_LONGER

# NotebookLM script webhook; note this identifies ONE authorized destination account.
NOTEBOOK_SYNC_SECRET=REPLACE_WITH_RANDOM_32_BYTES_OR_LONGER
NOTEBOOK_SYNC_USER_ID=CLERK_USER_ID_OF_OWNER
